# AERORUSH: SKYBOUND - Environment Configuration Reference
# Rename this file to .env.local to enable online features locally

# Optional: Supabase Online Leaderboard
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key

# Optional: Real-Time Multiplayer Server WebSocket URL
# Default fallback is ws://localhost:8080 if not set
VITE_MULTIPLAYER_SERVER_URL=ws://localhost:8080

# Optional: Google AdSense for Games (H5 Games Ads) Client ID
# Leave empty to run in clean offline mode without ads
VITE_ADSENSE_CLIENT_ID=
