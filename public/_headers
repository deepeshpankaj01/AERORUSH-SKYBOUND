# Cloudflare Pages Custom Headers Configuration
# https://developers.cloudflare.com/pages/configuration/headers/

# Security Headers for all HTML documents and routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Never cache Service Worker on CDN edge or browser to ensure instant updates
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# 1-year immutable caching for static bundled assets (Vite cache-busted hashes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons caching
/icon*.png
  Cache-Control: public, max-age=86400

/icon.svg
  Cache-Control: public, max-age=86400
